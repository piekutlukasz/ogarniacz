# Skopiuj do apps/api/.env. Wszystkie wartości są opcjonalne.
PORT=3000
# Adres nasłuchu. Domyślnie tylko lokalnie: z internetu ruch ma przechodzić przez proxy (nginx). W Dockerze 0.0.0.0.
# HOST=127.0.0.1
DATABASE_PATH=./data/ogarniacz.db
MIGRATIONS_DIR=./drizzle
PUBLIC_DIR=./public
# Cookie sesji tylko przez HTTPS. Domyślnie true przy NODE_ENV=production, lokalnie false.
# COOKIE_SECURE=true
# Kopie zapasowe: domyślnie katalog backups obok bazy, trzymane przez 14 dni.
# BACKUP_DIR=./data/backups
# BACKUP_KEEP_DAYS=14
# Kopia poza serwerem przez rclone, opis w docs/instrukcje/BACKUP.md. Bez BACKUP_REMOTE kopie zostają lokalnie.
# BACKUP_REMOTE=ogarniacz-backup:
# BACKUP_REMOTE_KEEP_DAYS=60
# Pełna ścieżka do rclone, gdy nie ma go w PATH procesu.
# RCLONE_PATH=/usr/local/bin/rclone
# Kalendarze ICS, opis w docs/instrukcje/KALENDARZE.md. Bez klucza kalendarze są wyłączone.
# Klucz: openssl rand -base64 32 (zapisz kopię w menedżerze haseł, nie ma jej w backupie).
# CALENDAR_ENCRYPTION_KEY=
# Dodatkowe hosty kalendarzy po przecinku. Domyślnie tylko Google i iCloud.
# CALENDAR_ALLOWED_HOSTS=outlook.office365.com
# Powiadomienia push, opis w docs/PROJEKT.md (rozdział 7). Klucze: npm run vapid -w @ogarniacz/api.
# Muszą być stałe: ich zmiana unieważnia subskrypcje na wszystkich telefonach. Bez kompletu trzech zmiennych powiadomienia są wyłączone.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:twoj@adres
