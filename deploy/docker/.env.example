# Skopiuj do .env obok docker-compose.yml i uzupełnij. Trzymaj ten plik poza repozytorium (chmod 600).
# Pełna lista ustawień z opisem: apps/api/.env.example, źródło prawdy: apps/api/src/config.ts.

# Domena instalacji, jedyne wymagane ustawienie w wariancie z Caddy (deploy/docker).
# Rekord DNS musi wskazywać na ten serwer, zanim Caddy poprosi o certyfikat.
DOMAIN=ogarniacz.example.org

# Kalendarze ICS, opis w docs/instrukcje/KALENDARZE.md. Klucz: openssl rand -base64 32.
# Zapisz go w menedżerze haseł: nie ma go w kopii bazy.
# CALENDAR_ENCRYPTION_KEY=
# CALENDAR_ALLOWED_HOSTS=outlook.office365.com

# Powiadomienia push. Klucze: npm run vapid -w @ogarniacz/api (w klonie repozytorium, na swoim komputerze).
# Muszą być stałe: ich zmiana unieważnia subskrypcje na wszystkich telefonach.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:twoj@adres

# Kopie lokalne na wolumenie /data, trzymane przez 14 dni.
# BACKUP_KEEP_DAYS=14
